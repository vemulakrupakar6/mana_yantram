{
  "info": {
    "name": "Mana Yantram · Milestones 1 and 2",
    "description": "Use the local environment and Postman’s cookie jar. Set a new username and a 12–128 character password before registration, or enter credentials for an existing development account. Login, registration and refresh store the returned bearer token in the active environment. Run the portal requests with matching roles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health and documentation",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response follows the success envelope\", () => pm.expect(pm.response.json().success).to.equal(true));"
