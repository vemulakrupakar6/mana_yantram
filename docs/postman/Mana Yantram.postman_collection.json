    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register farmer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Protection",
                "value": "1",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\",\n  \"role\": \"FARMER\",\n  \"preferredLanguage\": \"en\",\n  \"acceptTerms\": true,\n  \"acceptPrivacyPolicy\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Response follows the success envelope\", () => pm.expect(pm.response.json().success).to.equal(true));",
                  "if (pm.response.code === 201) { pm.environment.set('accessToken', pm.response.json().data.accessToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Protection",
                "value": "1",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response follows the success envelope\", () => pm.expect(pm.response.json().success).to.equal(true));",
                  "if (pm.response.code === 200) { pm.environment.set('accessToken', pm.response.json().data.accessToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Rotate refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Protection",
                "value": "1",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response follows the success envelope\", () => pm.expect(pm.response.json().success).to.equal(true));",
                  "if (pm.response.code === 200) { pm.environment.set('accessToken', pm.response.json().data.accessToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response follows the success envelope\", () => pm.expect(pm.response.json().success).to.equal(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Change password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-CSRF-Protection",
                "value": "1",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/change-password",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response follows the success envelope\", () => pm.expect(pm.response.json().success).to.equal(true));",
                  "if (pm.response.code === 200) { pm.environment.unset('accessToken'); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Log out current session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Protection",
                "value": "1",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response follows the success envelope\", () => pm.expect(pm.response.json().success).to.equal(true));",
                  "if (pm.response.code === 200) { pm.environment.unset('accessToken'); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Log out all sessions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Protection",
                "value": "1",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/logout-all",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response follows the success envelope\", () => pm.expect(pm.response.json().success).to.equal(true));",
                  "if (pm.response.code === 200) { pm.environment.unset('accessToken'); }"
                ]
              }
            }
          ]
        }
      ]
