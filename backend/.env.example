NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mana_yantram
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD
# Optional for automated tests. The database name must end in _test.
# DB_TEST_NAME=mana_yantram_test
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
LOG_LEVEL=info
STORAGE_ROOT=./storage
UPLOAD_MAX_DOCUMENT_MB=5
UPLOAD_MAX_PHOTO_MB=8
# 32 random bytes, base64. Generate: node -p "require('node:crypto').randomBytes(32).toString('base64')"
FIELD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
# 32+ random chars
AADHAAR_HASH_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET
# Used only by `npm run admin:create -w backend`
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
AUTH_MODE=password
SEED_DEMO_USERS=false
# Optional, only when demo seeding is enabled
# DEMO_FARMER_PASSWORD=
# DEMO_PROVIDER_PASSWORD=
# DEMO_DISTRICT_OFFICER_PASSWORD=
# DEMO_STATE_ADMIN_PASSWORD=

# DEMO_FIELD_AGENT_PASSWORD=
