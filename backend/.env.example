NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mana_yantram
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD
# Optional for automated tests. The database name must end in _test.
# DB_TEST_NAME=mana_yantram_test
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
LOG_LEVEL=info
AUTH_MODE=password
SEED_DEMO_USERS=false
# Optional, only when demo seeding is enabled
