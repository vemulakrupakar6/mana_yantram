{
  "name": "mana-yantram",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write .",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run db:test:prepare -w backend && npm run test:e2e -w frontend"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.73.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
